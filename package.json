{
  "name": "photostudio",
  "productName": "PhotoStudio",
  "version": "0.1.0",
  "description": "PhotoStudio: Alternative for Lightroom. RAW photo management and non-destructive editing",
  "main": "dist-electron/main.cjs",
  "author": "PhotoStudio",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "node scripts/copy-ort.mjs && vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "demo": "node scripts/gen-demo.mjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "exifr": "^7.1.3",
    "libheif-js": "^1.23.5",
    "libraw-wasm": "^1.6.0",
    "lucide-react": "^1.52.0",
    "onnxruntime-web": "1.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "1.56",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.photostudio.app",
    "productName": "PhotoStudio",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "category": "public.app-category.photography"
    },
    "linux": {
      "category": "Graphics",
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
